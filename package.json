{
  "name": "predict",
  "version": "0.0.1",
  "private": true,
  "description": "A small browser signal for the next useful step on a website.",
  "keywords": [
    "visitor-intent",
    "behavior-prediction",
    "cloudflare-workers",
    "workers-ai",
    "ai-gateway"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/acoyfellow/predict.git"
  },
  "homepage": "https://predict.coey.dev/",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "build": "bun build.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "lint": "bun run check",
    "deploy": "wrangler deploy",
    "install:demo": "bun scripts/install-demo.ts"
  },
  "dependencies": {
    "effect": "4.0.0-rc.116",
    "hono": "^4.12.19",
    "svelte": "^5.56.4",
    "svelte-hono": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260527.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.3.14",
    "esbuild": "0.25.10",
    "esbuild-svelte": "0.9.5",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "wrangler": "4.82.1"
  }
}
