{
  "name": "predict",
  "account_id": "bfcb6ac5b3ceaf42a09607f6f7925823",
  "main": "build/worker.bundled.mjs",
  "build": { "command": "bun run build" },
  "compatibility_date": "2026-04-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": { "directory": "./static" },
  "routes": [{ "pattern": "predict.coey.dev", "custom_domain": true, "zone_name": "coey.dev" }],
  "ratelimits": [{ "name": "PREDICT_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } }],
  "vars": { "AI_GATEWAY_ID": "default" },
  "env": { "development": { "vars": { "PREDICT_STUB": "1" } } }
}
